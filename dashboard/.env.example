# Copy to .env.local (gitignored — see .gitignore's `*.local`) and fill in
# the real admin key configured on the orchestrator (deploy/.env's
# ADMIN_API_KEY, default "dev-admin-key-change-me" in the dev compose stack).
#
# TODO(M8): move token minting behind real user auth — the admin key must not
# ship in a browser bundle. Every Vite env var prefixed VITE_ is inlined into
# the built JS and is trivially visible to anyone who opens devtools; this is
# a real security limitation of this dev-phase milestone, not a mistake to
# silently work around. M8 replaces this with proper user auth so the browser
# never holds an admin-scoped secret.
VITE_ADMIN_API_KEY=dev-admin-key-change-me

# The orchestrator's real, network-reachable base URL — used only to build
# the one-line enroll command shown in the "Add a node" modal (a peer agent
# dials this directly; it is NOT proxied through the dashboard's dev server).
# Defaults to http://localhost:8090 (this repo's compose stack) if unset.
VITE_ORCHESTRATOR_URL=http://localhost:8090
