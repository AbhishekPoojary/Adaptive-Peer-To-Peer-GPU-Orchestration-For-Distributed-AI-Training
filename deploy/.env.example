# Copy to deploy/.env and adjust as needed. Every variable read by
# deploy/compose.yaml or orchestrator/core/config.py is documented here.

# --- Postgres (used by the postgres service and by orchestrator's DATABASE_URL) ---
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage for checkpoints) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_CHECKPOINTS=checkpoints

# --- Orchestrator ---
ORCHESTRATOR_PORT=8000
APP_ENV=dev
LOG_LEVEL=INFO

# Built inside compose.yaml from the Postgres vars above; override directly
# if running the orchestrator outside compose (e.g. `uvicorn` on the host).
# DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator

# --- Database connection pool ---
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5.0

# S3 region sent with checkpoint requests; MinIO accepts any value.
S3_REGION=us-east-1

# --- Auth (ADR-008) ---
# Dev-only default; MUST be overridden with a real secret outside dev.
JWT_SIGNING_KEY=dev-only-change-me
JWT_ACCESS_TOKEN_TTL_SECONDS=900
ENROLLMENT_TOKEN_TTL_SECONDS=3600
# Static admin key gating POST /auth/enrollment-tokens. No production default:
# startup is refused in a non-dev APP_ENV if this is unset. Set a real secret.
ADMIN_API_KEY=dev-admin-key-change-me
# Challenge-response nonce lifetime for POST /auth/token/refresh.
AUTH_NONCE_TTL_SECONDS=120
# Smoothing factor (0<alpha<=1) for the RTT EWMA maintained from measured RTT.
RTT_EWMA_ALPHA=0.3
# Declared Beta(alpha,beta) reliability prior for a freshly enrolled node.
# Beta(1,1) is uniform: reliability is derived from lease history, not assumed.
RELIABILITY_PRIOR_ALPHA=1.0
RELIABILITY_PRIOR_BETA=1.0

# --- Scheduling (ADR-009) ---
SCHEDULER_STRATEGY=least_loaded
SCHEDULER_ALPHA_LOAD=1.0
SCHEDULER_BETA_RELIABILITY=1.0
SCHEDULER_GAMMA_LATENCY=0.5

# --- Leases (ADR-003) ---
LEASE_TTL_SECONDS=30
LEASE_RENEWAL_GRACE_SECONDS=5

# --- Failure detection (ADR-004) ---
HEARTBEAT_FLOOR_SECONDS=5.0
