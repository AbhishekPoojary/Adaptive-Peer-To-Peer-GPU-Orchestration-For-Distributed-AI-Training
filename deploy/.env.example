# Copy to deploy/.env and adjust as needed. Every variable read by
# deploy/compose.yaml or orchestrator/core/config.py is documented here.

# --- Postgres (used by the postgres service and by orchestrator's DATABASE_URL) ---
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage for checkpoints) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_CHECKPOINTS=checkpoints

# --- Orchestrator ---
ORCHESTRATOR_PORT=8000
APP_ENV=dev
LOG_LEVEL=INFO

# Built inside compose.yaml from the Postgres vars above; override directly
# if running the orchestrator outside compose (e.g. `uvicorn` on the host).
# DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator

# --- Database connection pool ---
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5.0

# S3 region sent with checkpoint requests; MinIO accepts any value.
S3_REGION=us-east-1

# --- Auth (ADR-008 machine identity, ADR-012 human identity) ---
# Dev-only default; MUST be overridden with a real secret outside dev. Signs
# BOTH node and user tokens; the `aud` claim is what keeps them apart, so
# rotating this invalidates every session and every agent token at once.
JWT_SIGNING_KEY=dev-only-change-me
JWT_ACCESS_TOKEN_TTL_SECONDS=900
ENROLLMENT_TOKEN_TTL_SECONDS=3600
# Static admin key for POST /auth/enrollment-tokens. Since M8 this is a
# *bootstrap* credential only — for CLI use before any user account exists.
# The dashboard no longer holds it; interactive admins authenticate as a user
# with the ADMIN role. No production default: startup is refused in a non-dev
# APP_ENV if this is unset.
ADMIN_API_KEY=dev-admin-key-change-me
# Challenge-response nonce lifetime for POST /auth/token/refresh.
AUTH_NONCE_TTL_SECONDS=120
# TTL of a human operator's access token (ADR-012). Shorter is safer: there is
# no revocation list, so a stolen token stays valid until it expires.
USER_ACCESS_TOKEN_TTL_SECONDS=900
# Fixed-window rate limits on the credential endpoints, per client IP. These
# bound password/nonce guessing. NOTE: the limiter is in-process, so running
# more than one orchestrator replica multiplies the effective limit by the
# replica count (ADR-012 §7).
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60.0
# Node-facing credential endpoints (challenge, token refresh, register). Higher
# than login: a fleet of agents legitimately refreshes on a timer, and the
# secret being presented is a 256-bit key rather than a human-chosen password.
NODE_AUTH_RATE_LIMIT_ATTEMPTS=60
NODE_AUTH_RATE_LIMIT_WINDOW_SECONDS=60.0
# Smoothing factor (0<alpha<=1) for the RTT EWMA maintained from measured RTT.
RTT_EWMA_ALPHA=0.3
# Declared Beta(alpha,beta) reliability prior for a freshly enrolled node.
# Beta(1,1) is uniform: reliability is derived from lease history, not assumed.
RELIABILITY_PRIOR_ALPHA=1.0
RELIABILITY_PRIOR_BETA=1.0
# Half-life (seconds) of the exponential decay on each historical lease outcome
# in the adaptive reliability score (ADR-009). Default 1 day: an outcome a day
# old counts half as much as a fresh one, so reliability recovers over time.
RELIABILITY_DECAY_HALFLIFE_SECONDS=86400.0
# Normal quantile for the Wilson score interval (~95% at 1.96). Larger = more
# conservative reliability. Logged/audited with every adaptive decision.
RELIABILITY_WILSON_Z=1.96

# --- Scheduling (ADR-009) ---
# adaptive (M3 penalty score) | least_loaded | round_robin. Default stays
# least_loaded; adaptive is selectable per job via scheduler_name.
SCHEDULER_STRATEGY=least_loaded
# Weights in S_i = alpha*L_i - beta*R_i + gamma*D_i (adaptive scheduler).
SCHEDULER_ALPHA_LOAD=1.0
SCHEDULER_BETA_RELIABILITY=1.0
SCHEDULER_GAMMA_LATENCY=0.5

# --- Leases (ADR-003) ---
LEASE_TTL_SECONDS=30
LEASE_RENEWAL_GRACE_SECONDS=5

# --- Distributed training / rendezvous (ADR-005, M5) ---
# TCP port the c10d rendezvous host binds; every rank dials <rdzv host>:PORT.
RENDEZVOUS_PORT=29500
# torchrun --max-restarts: bounded elastic re-formation on a worker crash.
TORCHRUN_MAX_RESTARTS=1
# torch.distributed backend: gloo (M5 verified, CPU/mixed) or nccl (real multi-GPU).
TRAINING_BACKEND=gloo

# --- Background loops (M2) ---
# How often the scheduler pass and the lease expiry sweep wake (seconds). A
# job submit also triggers an immediate scheduler pass. ENABLE_BACKGROUND_LOOPS
# turns both loops off (used by tests, which drive scheduling deterministically).
SCHEDULER_PASS_INTERVAL_SECONDS=3.0
LEASE_SWEEP_INTERVAL_SECONDS=3.0
ENABLE_BACKGROUND_LOOPS=true

# --- Failure detection (ADR-004, M6 φ-accrual detector) ---
# The detector maintains a per-node distribution of recent heartbeat intervals
# and computes a φ suspicion for the current silence, declaring a node OFFLINE
# (and immediately reassigning its jobs) when φ crosses the threshold — but
# never faster than the hard floor. See docs/adr/ADR-004-addendum.md.
FAILURE_DETECTOR_INTERVAL_SECONDS=1.0
# Hard floor: no node is ever declared failed with less silence than this.
HEARTBEAT_FLOOR_SECONDS=5.0
# φ threshold; φ=-log10(P(a heartbeat arrives this late)). 3.0 ≈ "≤0.1% likely".
PHI_ACCRUAL_THRESHOLD=3.0
# Rolling window of most-recent heartbeat intervals fitted to a Normal.
PHI_ACCRUAL_WINDOW_SAMPLES=20
# Floor on the fitted interval stddev (seconds) — a numerical safety guard.
PHI_ACCRUAL_MIN_STD_SECONDS=0.5
# Minimum observed intervals before the fitted distribution is trusted.
PHI_ACCRUAL_MIN_INTERVALS=3
# Bootstrap fallback silence (seconds) before enough history exists to fit.
PHI_ACCRUAL_BOOTSTRAP_SILENCE_SECONDS=10.0

# --- Checkpoints (ADR-006, M6). Read by the agent/trainer (not the
# orchestrator): S3_ENDPOINT_URL / S3_ACCESS_KEY / S3_SECRET_KEY /
# S3_BUCKET_CHECKPOINTS above are passed through to the trainer container, which
# writes model+optimizer checkpoints to MinIO and resumes from them on a
# reassigned attempt. Rank-0 checkpoint cadence in optimizer steps. ---
CHECKPOINT_EVERY_N_STEPS=100

# --- Read API (M1) ---
# A node is reported heartbeat_stale=true once now - last_heartbeat_at exceeds
# this window. Computed on read only; does not mutate node status.
HEARTBEAT_STALE_SECONDS=15.0
NODE_DETAIL_DEFAULT_SAMPLES=50
NODE_DETAIL_MAX_SAMPLES=500
